# Mapbox GL JS — free tier (50k map loads/month)
# Get your token at https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=your_mapbox_access_token_here

# ─────────────────────────────────────────────────────────────────
# Voice Ordering — server-side only (no VITE_ prefix; never sent to browser)
# Copy this file to .env.local and fill in. .env.local is gitignored.
# After editing, restart `npm run dev`.
#
# Pick ONE Claude transport: ANTHROPIC_API_KEY (preferred) OR the AWS_*
# trio (Bedrock). Setting both is fine — Anthropic-direct wins by default.
# ─────────────────────────────────────────────────────────────────

# Anthropic API direct — PREFERRED (simplest, fastest setup)
# Get a key at https://console.anthropic.com/settings/keys
# Free tier includes $5 in credits — ~150 conversations for this POC.
# Cost: ~$0.001-0.005 per turn with prompt caching enabled.
ANTHROPIC_API_KEY=sk-ant-...

# AWS Bedrock — fallback path. Use when running on AWS infrastructure
# or when Anthropic-direct billing is a problem.
# Region must support the model (us-east-2 / us-east-1 / us-west-2 work).
# IAM credentials need bedrock:InvokeModel permission for the model ID
# (default: us.anthropic.claude-haiku-4-5-v1:0).
# AWS_REGION=us-east-2
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ElevenLabs — for TTS (synthesis only — UI playback not yet wired)
# Get an API key at https://elevenlabs.io/app/settings/api-keys
# Voice ID is optional; default is Rachel (warm, neutral).
# Pick from https://elevenlabs.io/app/voice-library
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
